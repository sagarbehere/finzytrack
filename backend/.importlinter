# Dependency contracts of the main sidecar (ARCHITECTURE.md §2.4; ADR-0054; INV-12). T1 and pre-push run
# `lint-imports` from backend/. A package in parentheses is optional until its slice creates it; that slice
# removes the parentheses. There are no transitional exemptions (PROCESS.md §6).
# domain may not import app.platform at all (the layers contract), so rule 3's `app.platform.adapters` ban is
# added for `*.core` modules when the first slice core exists.
# BL-0041 revises the kernel layers for the engine split (ledger and the mirror build live in engine/).

[importlinter]
root_packages =
    app
include_external_packages = True

[importlinter:contract:kernel-layers]
name = Kernel layers (ARCHITECTURE.md §2.4 rule 1)
type = layers
layers =
    app.main
    app.api
    (app.boot)
    app.workspaces
    app.mirror
    app.platform
    app.domain

[importlinter:contract:no-beancount]
name = The main sidecar never imports Beancount (ADR-0054, INV-02)
type = forbidden
source_modules =
    app
forbidden_modules =
    beancount
    beanquery

[importlinter:contract:domain-pure]
name = domain is pure (ARCHITECTURE.md §2.4 rule 3, EP-01)
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    fastapi
    pydantic
    sqlite3
    httpx
    portalocker
    os
    pathlib
    subprocess
    socket
    time
    random
    secrets
    uuid

[importlinter:contract:content-pure]
name = content is pure (ARCHITECTURE.md §2.3, ADR-0022, EP-10)
type = forbidden
source_modules =
    app.content
forbidden_modules =
    app.platform
    app.mirror
    app.workspaces
    app.boot
    app.api
    app.main
    fastapi
    pydantic
    sqlite3
    httpx
    portalocker
    os
    pathlib
    subprocess
    socket
    time
    random
    secrets
    uuid

[importlinter:contract:one-logger]
# Only app.platform.observability imports logging or structlog: every line goes through the registry and redaction.
name = One logger (ARCHITECTURE.md §6A, EP-15, EP-26)
type = forbidden
source_modules =
    app
forbidden_modules =
    logging
    structlog
ignore_imports =
    app.platform.observability.* -> logging
    app.platform.observability.* -> structlog

[importlinter:contract:engine-supervision-pure]
# The engine supervision table decides; the client does the I/O (S0040; EP-01, EP-17). It may name log events (the
# registry is data) but not write them, and it reads no clock: every time comes in on an event.
name = The engine supervision table is pure (ARCHITECTURE.md §7, EP-01)
type = forbidden
source_modules =
    app.platform.engine_supervision
forbidden_modules =
    app.platform.adapters
    app.platform.observability.log
    app.platform.observability.redaction
    os
    pathlib
    subprocess
    threading
    queue
    socket
    signal
    time
    random
    secrets
    uuid
    datetime

[importlinter:contract:workspace-format-pure]
# The workspace format reads bytes and returns values; the open does the I/O (ADR-0017: one extractable format
# package; ARCHITECTURE.md §2.3: `format/` imports only `domain` + pydantic; EP-01; S0051).
name = The workspace format is pure (ARCHITECTURE.md §2.3, ADR-0017)
type = forbidden
source_modules =
    app.workspaces.format
forbidden_modules =
    app.platform
    app.api
    app.main
    app.workspaces.access
    fastapi
    sqlite3
    httpx
    portalocker
    os
    pathlib
    subprocess
    socket
    time
    random
    secrets
    uuid

[importlinter:contract:engine-queue-pure]
# The engine job queue's table decides; the scheduler shell does the I/O (S0053, S0058; engine-jobs §12: "no clock,
# random value, environment or global"; EP-01, EP-17).
name = The engine job queue table is pure (engine-jobs §12, EP-01)
type = forbidden
source_modules =
    app.platform.engine_jobs.queue
forbidden_modules =
    app.platform.adapters
    app.platform.engine_jobs.scheduler
    app.platform.observability
    os
    pathlib
    subprocess
    threading
    queue
    socket
    signal
    time
    random
    secrets
    uuid
    datetime
