{
  "schemaVersion": 2,
  "id": "budget-history",
  "title": "Budget: History",
  "description": "Budget vs actual, month by month: the trend and a per-account adherence heat-map.",
  "parameters": [
    { "name": "from", "label": "From (month)", "type": "date", "default": { "$gen": "startOfMonth", "offset": -11 } },
    { "name": "to", "label": "To (month)", "type": "date", "default": { "$gen": "endOfMonth" } },
    { "name": "currency", "label": "Currency", "type": "select", "default": { "$gen": "defaultCurrency" }, "optionsFrom": "currencies" }
  ],

  "steps": [
    {
      "id": "budgets-pp",
      "kind": "compute",
      "fn": "budget_for_range",
      "args": { "from": "{{params.from}}", "to": "{{params.to}}", "currency": "{{params.currency}}", "groupBy": "period" }
    },
    {
      "id": "budget-by-month",
      "kind": "transform",
      "fn": "groupBy",
      "inputs": ["{{steps.budgets-pp}}"],
      "config": { "key": "period", "sum": ["budget"] }
    },
    {
      "id": "actuals-by-month",
      "kind": "query",
      "query": "SELECT year_month AS period, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE account_type = 'Expenses' AND year_month BETWEEN substr(:from, 1, 7) AND substr(:to, 1, 7) AND currency = :currency GROUP BY year_month"
    },
    {
      "id": "by-period",
      "kind": "transform",
      "fn": "joinByPeriod",
      "inputs": ["{{steps.budget-by-month}}", "{{steps.actuals-by-month}}"]
    },
    {
      "id": "actuals-pp",
      "kind": "query",
      "query": "SELECT account, currency, year_month AS period, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE account_type = 'Expenses' AND year_month BETWEEN substr(:from, 1, 7) AND substr(:to, 1, 7) AND currency = :currency GROUP BY account, currency, year_month"
    },
    {
      "id": "adherence",
      "kind": "transform",
      "fn": "joinBudgetActualByPeriod",
      "inputs": ["{{steps.budgets-pp}}", "{{steps.actuals-pp}}"]
    }
  ],

  "layout": {
    "columns": 12,
    "gap": "1.5rem",
    "rowHeight": "150px",
    "widgets": [
      { "widgetId": "trend",   "gridArea": "1 / 1 / 4 / 13" },
      { "widgetId": "heatmap", "gridArea": "4 / 1 / 9 / 13" }
    ]
  },

  "widgets": [
    {
      "id": "trend",
      "title": "Total budget vs actual, by month",
      "helpText": "Total budget vs total spend each month. Tall actual bars are the months you ran over.",
      "steps": [{ "id": "rows", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.by-period}}"] }],
      "output": "rows",
      "visualization": {
        "type": "chart",
        "chartType": "bar",
        "yAxisLabelFormat": "compact",
        "options": {
          "tooltip": { "trigger": "axis" },
          "legend": { "show": true, "top": 0, "left": "center" },
          "grid": { "top": 40, "bottom": 28, "left": 56, "right": 20 },
          "xAxis": { "type": "category" },
          "yAxis": { "type": "value", "splitLine": { "lineStyle": { "type": "dashed", "opacity": 0.6 } } },
          "series": [
            { "name": "Budget", "type": "bar", "encode": { "x": "period", "y": "budget" }, "itemStyle": { "color": "#94a3b8" } },
            { "name": "Actual", "type": "bar", "encode": { "x": "period", "y": "actual" }, "itemStyle": { "color": "#6366f1" } }
          ]
        }
      }
    },
    {
      "id": "heatmap",
      "title": "Adherence heat-map",
      "helpText": "How much of each account's monthly budget was used: green under, amber close, blue on the nose, red over. Blank = no budget that month. Click a cell for its transactions.",
      "steps": [
        {
          "id": "pivoted",
          "kind": "transform",
          "fn": "pivot",
          "inputs": ["{{dashboard.steps.adherence}}"],
          "config": { "rowField": "account", "columnField": "period", "valueField": "pctUsed", "formatColumn": "monthYear", "sortRowsBy": "label_asc" }
        }
      ],
      "output": "pivoted",
      "visualization": {
        "type": "pivot",
        "rowHeader": "Account",
        "format": "percent",
        "showRowTotals": false,
        "showColumnTotals": false,
        "colorByValue": true,
        "valueLink": {
          "name": "transactions",
          "query": {
            "accountContains": "{{row.label}}",
            "dateFrom": "{{columnMeta.startDate}}",
            "dateTo": "{{columnMeta.endDate}}"
          }
        }
      }
    }
  ]
}
