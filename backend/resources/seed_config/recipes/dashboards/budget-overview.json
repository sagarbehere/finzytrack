{
  "schemaVersion": 2,
  "id": "budget-overview",
  "title": "Budget — Overview",
  "description": "Your budget at a glance — budgeted vs spent for each account, plus the spending outside any budget.",
  "parameters": [
    { "name": "monthStart", "label": "From", "type": "date", "default": { "$gen": "startOfMonth" } },
    { "name": "monthEnd", "label": "To", "type": "date", "default": { "$gen": "endOfMonth" } },
    { "name": "currency", "label": "Currency", "type": "select", "default": { "$gen": "defaultCurrency" }, "optionsFrom": "currencies" }
  ],

  "steps": [
    {
      "id": "actuals",
      "kind": "query",
      "query": "SELECT account, currency, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE account_type = 'Expenses' AND transaction_date BETWEEN :monthStart AND :monthEnd AND currency = :currency GROUP BY account, currency"
    },
    {
      "id": "budgets",
      "kind": "compute",
      "fn": "budget_for_range",
      "args": { "from": "{{params.monthStart}}", "to": "{{params.monthEnd}}", "currency": "{{params.currency}}" }
    },
    {
      "id": "flat",
      "kind": "transform",
      "fn": "joinBudgetActual",
      "inputs": ["{{steps.budgets}}", "{{steps.actuals}}"]
    },
    {
      "id": "ranked",
      "kind": "transform",
      "fn": "sortBy",
      "inputs": ["{{steps.flat}}"],
      "config": { "field": "pctUsed", "order": "desc" }
    },
    {
      "id": "summary",
      "kind": "transform",
      "fn": "budgetSummary",
      "inputs": ["{{steps.budgets}}", "{{steps.actuals}}"]
    }
  ],

  "layout": {
    "columns": 12,
    "gap": "1.5rem",
    "rowHeight": "150px",
    "widgets": [
      { "widgetId": "kpi-budgeted",  "gridArea": "1 / 1 / 2 / 5" },
      { "widgetId": "kpi-spent",     "gridArea": "1 / 5 / 2 / 9" },
      { "widgetId": "kpi-remaining", "gridArea": "1 / 9 / 2 / 13" },
      { "widgetId": "unbudgeted",    "gridArea": "2 / 1 / 6 / 5" },
      { "widgetId": "by-account",    "gridArea": "2 / 5 / 6 / 13" }
    ]
  },

  "widgets": [
    {
      "id": "kpi-budgeted",
      "title": "Budgeted",
      "helpText": "Your total budget for the selected period, across all budgeted accounts. A nested budget (a parent and its child) is counted once.",
      "steps": [
        { "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.summary}}"] }
      ],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "◎", "iconColor": "blue", "multiCurrency": true, "amountField": "budget", "currencyField": "currency" }
    },
    {
      "id": "kpi-spent",
      "title": "Spent",
      "helpText": "Total spending in budgeted accounts over the selected period.",
      "steps": [
        { "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.summary}}"] }
      ],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "$", "iconColor": "purple", "multiCurrency": true, "amountField": "actual", "currencyField": "currency" }
    },
    {
      "id": "kpi-remaining",
      "title": "Remaining",
      "helpText": "Budget minus spending — how much of your total budget is still available. Negative means you're over budget overall.",
      "steps": [
        { "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.summary}}"] }
      ],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "=", "multiCurrency": true, "amountField": "remaining", "currencyField": "currency", "colorBySign": true }
    },
    {
      "id": "unbudgeted",
      "title": "Unbudgeted spending",
      "helpText": "Accounts you're spending on that aren't covered by any budget, biggest first — money leaking outside your budgets. A budget on a parent account covers its whole subtree, so those don't appear here. Click a row for that account's transactions.",
      "steps": [
        { "id": "leaks", "kind": "transform", "fn": "unbudgetedSpending", "inputs": ["{{dashboard.steps.budgets}}", "{{dashboard.steps.actuals}}"] },
        { "id": "with-total", "kind": "transform", "fn": "appendTotal", "inputs": ["{{steps.leaks}}"], "config": { "field": "actual", "label": "Total" } }
      ],
      "output": "with-total",
      "visualization": {
        "type": "table",
        "emptyText": "Nothing's leaking — every account with spending is covered by a budget.",
        "columns": [
          { "key": "account", "label": "Account", "format": "accountName2", "link": { "name": "transactions", "query": { "accountContains": "{{row.account}}", "dateFrom": "{{parameters.monthStart}}", "dateTo": "{{parameters.monthEnd}}" } } },
          { "key": "actual", "label": "Spent", "format": "currency", "align": "right" }
        ]
      }
    },
    {
      "id": "by-account",
      "title": "By Account",
      "helpText": "Every budgeted account, sorted so the fullest budgets surface first. Spent vs budget, over-budget in red. A budget on a parent account is compared against the parent and all its descendants. Click a row for that account's transactions.",
      "steps": [
        { "id": "rows", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.ranked}}"] }
      ],
      "output": "rows",
      "visualization": {
        "type": "budget-progress",
        "accountFormat": "accountName2",
        "emptyText": "No budgets or spending for this range. Set budgets in the Budgets view, then pick a date range and currency that have data.",
        "link": {
          "name": "transactions",
          "query": {
            "accountContains": "{{row.account}}",
            "dateFrom": "{{parameters.monthStart}}",
            "dateTo": "{{parameters.monthEnd}}"
          }
        }
      }
    }
  ]
}
