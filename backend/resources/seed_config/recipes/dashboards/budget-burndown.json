{
  "schemaVersion": 2,
  "id": "budget-burndown",
  "title": "Budget — Burn-down",
  "description": "Cumulative actual vs cumulative budget, month by month over a span, for one account. If the cumulative-actual line crosses above cumulative-budget, you're pacing over budget.",
  "parameters": [
    { "name": "from", "label": "From", "type": "date", "default": { "$gen": "startOfYear" } },
    { "name": "to", "label": "To", "type": "date", "default": { "$gen": "endOfYear" } },
    { "name": "currency", "label": "Currency", "type": "select", "default": { "$gen": "defaultCurrency" }, "optionsFrom": "currencies" },
    {
      "name": "account", "label": "Account", "type": "select", "default": "Expenses:Groceries",
      "options": [
        { "value": "Expenses:Groceries", "label": "Groceries" },
        { "value": "Expenses:EatingOut", "label": "Eating Out" },
        { "value": "Expenses:HouseRent", "label": "House Rent" },
        { "value": "Expenses:Utilities", "label": "Utilities" }
      ]
    }
  ],
  "layout": {
    "columns": 12,
    "gap": "1.5rem",
    "rowHeight": "320px",
    "widgets": [
      { "widgetId": "burndown", "gridArea": "1 / 1 / 2 / 13" }
    ]
  },
  "widgets": [
    {
      "id": "burndown",
      "title": "Cumulative budget vs actual",
      "steps": [
        {
          "id": "actuals",
          "kind": "sql",
          "query": "SELECT year_month AS period, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE account = :account AND transaction_date BETWEEN :from AND :to AND currency = :currency GROUP BY year_month ORDER BY year_month"
        },
        {
          "id": "budgets",
          "kind": "compute",
          "fn": "budget_for_range",
          "args": { "from": "{{params.from}}", "to": "{{params.to}}", "currency": "{{params.currency}}", "account": "{{params.account}}", "groupBy": "period" }
        },
        {
          "id": "by-period",
          "kind": "transform",
          "fn": "joinByPeriod",
          "inputs": ["{{steps.budgets}}", "{{steps.actuals}}"]
        },
        {
          "id": "cumulative",
          "kind": "transform",
          "fn": "runningSum",
          "inputs": ["{{steps.by-period}}"],
          "config": { "fields": ["budget", "actual"], "orderBy": "period" }
        }
      ],
      "output": "cumulative",
      "visualization": {
        "type": "table",
        "columns": [
          { "key": "period", "label": "Month" },
          { "key": "budget", "label": "Budget", "format": "currency", "align": "right" },
          { "key": "actual", "label": "Actual", "format": "currency", "align": "right" },
          { "key": "cumulativeBudget", "label": "Cumulative Budget", "format": "currency", "align": "right" },
          { "key": "cumulativeActual", "label": "Cumulative Actual", "format": "currency", "align": "right" }
        ]
      }
    }
  ]
}
