{
  "schemaVersion": 2,
  "id": "budget-envelopes",
  "title": "Budget: Envelopes",
  "description": "Envelope budgeting with rollover: each envelope's carried-forward balance, with a drill-down into its month-by-month trend.",
  "parameters": [
    { "name": "asOf", "label": "As of", "type": "date", "default": { "$gen": "endOfMonth" } },
    { "name": "fresh", "label": "Start fresh", "type": "boolean", "default": "false" },
    { "name": "freshDate", "label": "From", "type": "date", "default": { "$gen": "startOfYear" }, "showWhen": { "param": "fresh", "equals": true }, "maxParam": "asOf" },
    { "name": "currency", "label": "Currency", "type": "select", "default": { "$gen": "defaultCurrency" }, "optionsFrom": "currencies" },
    { "name": "account", "label": "Envelope", "type": "select", "default": "Expenses:Groceries", "hidden": true }
  ],

  "steps": [
    {
      "id": "pp-budgets",
      "kind": "compute",
      "fn": "budget_for_range",
      "args": { "to": "{{params.asOf}}", "currency": "{{params.currency}}", "groupBy": "period" }
    },
    {
      "id": "pp-actuals",
      "kind": "query",
      "query": "SELECT account, currency, year_month AS period, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE account_type = 'Expenses' AND transaction_date <= :asOf AND currency = :currency GROUP BY account, currency, year_month"
    },
    {
      "id": "balances",
      "kind": "transform",
      "fn": "envelopeBalances",
      "inputs": ["{{steps.pp-budgets}}", "{{steps.pp-actuals}}"],
      "config": { "reset": "{{params.fresh}}", "resetFrom": "{{params.freshDate}}" }
    },
    {
      "id": "ranked",
      "kind": "transform",
      "fn": "sortBy",
      "inputs": ["{{steps.balances}}"],
      "config": { "field": "pctUsed", "order": "desc" }
    },

    {
      "id": "d-actuals",
      "kind": "query",
      "query": "SELECT year_month AS period, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE (account = :account OR account LIKE :account || ':%') AND transaction_date <= :asOf AND currency = :currency GROUP BY year_month ORDER BY year_month"
    },
    {
      "id": "d-budgets",
      "kind": "compute",
      "fn": "budget_for_range",
      "args": { "to": "{{params.asOf}}", "currency": "{{params.currency}}", "account": "{{params.account}}", "groupBy": "period" }
    },
    {
      "id": "rollover",
      "kind": "transform",
      "fn": "envelopeRollover",
      "inputs": ["{{steps.d-budgets}}", "{{steps.d-actuals}}"],
      "config": { "reset": "{{params.fresh}}", "resetFrom": "{{params.freshDate}}" }
    },
    {
      "id": "sorted-desc",
      "kind": "transform",
      "fn": "sortBy",
      "inputs": ["{{steps.rollover}}"],
      "config": { "field": "period", "order": "desc" }
    },
    {
      "id": "latest",
      "kind": "transform",
      "fn": "limit",
      "inputs": ["{{steps.sorted-desc}}"],
      "config": { "count": 1 }
    }
  ],

  "layout": {
    "columns": 12,
    "gap": "1.5rem",
    "rowHeight": "150px",
    "widgets": [
      { "widgetId": "overview",      "gridArea": "1 / 1 / 4 / 13" },
      { "widgetId": "kpi-available", "gridArea": "4 / 1 / 5 / 5" },
      { "widgetId": "kpi-spent",     "gridArea": "4 / 5 / 5 / 9" },
      { "widgetId": "kpi-balance",   "gridArea": "4 / 9 / 5 / 13" },
      { "widgetId": "carryover",     "gridArea": "5 / 1 / 8 / 13" }
    ]
  },

  "widgets": [
    {
      "id": "overview",
      "title": "✉ Envelope balances",
      "helpText": "What's left in each envelope now: unspent budget carried forward. Red means overspent. Click one to see its trend.",
      "steps": [
        { "id": "rows", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.ranked}}"] }
      ],
      "output": "rows",
      "visualization": {
        "type": "budget-progress",
        "accountFormat": "accountName2",
        "emptyText": "No budgets or spending for this currency. Set budgets in the Budgets view, then pick a currency and 'As of' date that have data.",
        "link": { "select": { "account": "{{row.account}}" } }
      }
    },
    {
      "id": "kpi-available",
      "title": "{{params.account:accountName}}: Available",
      "helpText": "This month's opening balance: last month's carryover plus this month's budget.",
      "steps": [
        { "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.latest}}"] }
      ],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "◎", "iconColor": "{{theme.brand}}", "multiCurrency": true, "amountField": "available", "currencyField": "currency" }
    },
    {
      "id": "kpi-spent",
      "title": "{{params.account:accountName}}: Spent",
      "helpText": "Spent from this envelope this month.",
      "steps": [
        { "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.latest}}"] }
      ],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "$", "iconColor": "{{theme.brand}}", "multiCurrency": true, "amountField": "actual", "currencyField": "currency" }
    },
    {
      "id": "kpi-balance",
      "title": "{{params.account:accountName}}: In envelope now",
      "helpText": "This month's closing balance: available minus spent. Negative (red) means overspent.",
      "steps": [
        { "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.latest}}"] }
      ],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "✉", "multiCurrency": true, "amountField": "carryover", "currencyField": "currency", "colorBySign": true }
    },
    {
      "id": "carryover",
      "title": "{{params.account:accountName}}: Balance over time",
      "helpText": "The envelope's month-end balance over time. Rising means you're saving unspent budget; below zero means overspent. Click a point for that month's transactions.",
      "steps": [
        { "id": "rows", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.rollover}}"] }
      ],
      "output": "rows",
      "visualization": {
        "type": "chart",
        "chartType": "area",
        "yAxisLabelFormat": "compact",
        "options": {
          "tooltip": { "trigger": "axis" },
          "legend": { "show": false },
          "grid": { "top": 16, "bottom": 24, "left": 56, "right": 20 },
          "xAxis": { "type": "category" },
          "yAxis": { "type": "value", "splitLine": { "lineStyle": { "type": "dashed", "opacity": 0.6 } } },
          "series": [
            {
              "name": "Carryover",
              "type": "line",
              "smooth": true,
              "encode": { "x": "period", "y": "carryover" },
              "itemStyle": { "color": "{{theme.brand}}" },
              "areaStyle": { "opacity": 0.25 },
              "lineStyle": { "width": 2 }
            }
          ]
        },
        "clickLink": {
          "name": "transactions",
          "query": {
            "accountContains": "{{parameters.account}}",
            "dateFrom": "{{data.dateFrom}}",
            "dateTo": "{{data.dateTo}}"
          }
        }
      }
    }
  ]
}
