{
  "schemaVersion": 2,
  "id": "budget-envelopes",
  "title": "Budget — Envelopes (rollover)",
  "description": "Envelope budgeting with rollover: unspent budget carries forward to the next month, and overspending eats into it. 'Available' is last month's carryover plus this month's budget; 'Carryover' is what's left at month end.",
  "parameters": [
    { "name": "from", "label": "From", "type": "date", "default": { "$gen": "startOfYear" } },
    { "name": "to", "label": "To", "type": "date", "default": { "$gen": "endOfYear" } },
    { "name": "currency", "label": "Currency", "type": "select", "default": { "$gen": "defaultCurrency" }, "optionsFrom": "currencies" },
    {
      "name": "account", "label": "Envelope", "type": "select", "default": "Expenses:Groceries",
      "options": [
        { "value": "Expenses:Groceries", "label": "Groceries" },
        { "value": "Expenses:EatingOut", "label": "Eating Out" },
        { "value": "Expenses:Entertainment", "label": "Entertainment" },
        { "value": "Expenses:Travel", "label": "Travel" }
      ]
    }
  ],
  "layout": {
    "columns": 12,
    "gap": "1.5rem",
    "rowHeight": "320px",
    "widgets": [
      { "widgetId": "envelope", "gridArea": "1 / 1 / 2 / 13" }
    ]
  },
  "widgets": [
    {
      "id": "envelope",
      "title": "Envelope balance over time",
      "steps": [
        {
          "id": "actuals",
          "kind": "sql",
          "query": "SELECT year_month AS period, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE account = :account AND transaction_date BETWEEN :from AND :to AND currency = :currency GROUP BY year_month ORDER BY year_month"
        },
        {
          "id": "budgets",
          "kind": "compute",
          "fn": "budget_for_range",
          "args": { "from": "{{params.from}}", "to": "{{params.to}}", "currency": "{{params.currency}}", "account": "{{params.account}}", "groupBy": "period" }
        },
        {
          "id": "rollover",
          "kind": "transform",
          "fn": "envelopeRollover",
          "inputs": ["{{steps.budgets}}", "{{steps.actuals}}"]
        }
      ],
      "output": "rollover",
      "visualization": {
        "type": "table",
        "columns": [
          { "key": "period", "label": "Month" },
          { "key": "budget", "label": "Budget", "format": "currency", "align": "right" },
          { "key": "actual", "label": "Spent", "format": "currency", "align": "right" },
          { "key": "available", "label": "Available", "format": "currency", "align": "right" },
          { "key": "carryover", "label": "Carryover", "format": "signedCurrency", "align": "right" }
        ]
      }
    }
  ]
}
