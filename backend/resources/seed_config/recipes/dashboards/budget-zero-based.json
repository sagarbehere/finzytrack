{
  "schemaVersion": 2,
  "id": "budget-zero-based",
  "title": "Budget: Zero-based",
  "description": "Top-down 'every dollar a job': a total carved into named budgets and an Unbudgeted remainder, all the way down.",
  "parameters": [
    { "name": "totalAccount", "label": "Total account", "type": "select", "default": "Expenses", "optionsFrom": "budgetTotals" },
    { "name": "monthStart", "label": "From", "type": "date", "default": { "$gen": "startOfMonth" } },
    { "name": "monthEnd", "label": "To", "type": "date", "default": { "$gen": "endOfMonth" } },
    { "name": "currency", "label": "Currency", "type": "select", "default": { "$gen": "defaultCurrency" }, "optionsFrom": "currencies" }
  ],

  "steps": [
    {
      "id": "actuals",
      "kind": "query",
      "query": "SELECT account, currency, SUM(CAST(amount AS REAL)) AS actual FROM postings WHERE (account = :totalAccount OR account LIKE :totalAccount || ':%') AND transaction_date BETWEEN :monthStart AND :monthEnd AND currency = :currency GROUP BY account, currency"
    },
    {
      "id": "budgets",
      "kind": "compute",
      "fn": "budget_for_range",
      "args": { "from": "{{params.monthStart}}", "to": "{{params.monthEnd}}", "currency": "{{params.currency}}", "includeRoots": true }
    },
    {
      "id": "flat",
      "kind": "transform",
      "fn": "joinBudgetActual",
      "inputs": ["{{steps.budgets}}", "{{steps.actuals}}"],
      "config": { "totalAccount": "{{params.totalAccount}}" }
    },
    {
      "id": "carve-outs",
      "kind": "transform",
      "fn": "where",
      "inputs": ["{{steps.flat}}"],
      "config": { "field": "kind", "notEquals": "total" }
    },
    {
      "id": "total-row",
      "kind": "transform",
      "fn": "where",
      "inputs": ["{{steps.flat}}"],
      "config": { "field": "kind", "equals": "total" }
    }
  ],

  "layout": {
    "columns": 12,
    "gap": "1.5rem",
    "rowHeight": "150px",
    "widgets": [
      { "widgetId": "kpi-total",  "gridArea": "1 / 1 / 2 / 5" },
      { "widgetId": "kpi-spent",  "gridArea": "1 / 5 / 2 / 9" },
      { "widgetId": "kpi-left",   "gridArea": "1 / 9 / 2 / 13" },
      { "widgetId": "sunburst",   "gridArea": "2 / 1 / 7 / 8" },
      { "widgetId": "carve-outs", "gridArea": "2 / 8 / 7 / 13" }
    ]
  },

  "widgets": [
    {
      "id": "kpi-total",
      "title": "Total budget",
      "helpText": "The total budget for the account you picked.",
      "steps": [{ "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.total-row}}"] }],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "◎", "iconColor": "{{theme.brand}}", "multiCurrency": true, "amountField": "budget", "currencyField": "currency" }
    },
    {
      "id": "kpi-spent",
      "title": "Spent",
      "helpText": "Total spending under that account. Click to see the transactions.",
      "steps": [{ "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.total-row}}"] }],
      "output": "row",
      "visualization": {
        "type": "kpi", "icon": "$", "iconColor": "{{theme.brand}}", "multiCurrency": true, "amountField": "actual", "currencyField": "currency",
        "clickLink": {
          "name": "transactions",
          "query": { "accountContains": "{{parameters.totalAccount}}", "dateFrom": "{{parameters.monthStart}}", "dateTo": "{{parameters.monthEnd}}" }
        }
      }
    },
    {
      "id": "kpi-left",
      "title": "Left",
      "helpText": "Total budget minus spending. Negative (red) means you've overspent the total.",
      "steps": [{ "id": "row", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.total-row}}"] }],
      "output": "row",
      "visualization": { "type": "kpi", "icon": "=", "multiCurrency": true, "amountField": "remaining", "currencyField": "currency", "colorBySign": true }
    },
    {
      "id": "sunburst",
      "title": "How the total is carved",
      "helpText": "The total split into named budgets and an Unbudgeted remainder at each level. Each ring sums to the one inside it.",
      "steps": [
        { "id": "tree", "kind": "transform", "fn": "budgetTree", "inputs": ["{{dashboard.steps.budgets}}"], "config": { "totalAccount": "{{params.totalAccount}}" } }
      ],
      "output": "tree",
      "visualization": {
        "type": "chart",
        "chartType": "sunburst",
        "options": {
          "tooltip": { "trigger": "item" },
          "series": [
            {
              "type": "sunburst",
              "radius": [0, "92%"],
              "label": { "rotate": "tangential", "minAngle": 6, "fontSize": 10 },
              "itemStyle": { "borderColor": "#fff", "borderWidth": 1 },
              "levels": [
                {},
                { "r0": "12%", "r": "48%", "label": { "rotate": "tangential" } },
                { "r0": "48%", "r": "80%", "label": { "rotate": "tangential" } },
                { "r0": "80%", "r": "92%", "label": { "position": "outside", "padding": 3, "silent": false } }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "carve-outs",
      "title": "Carve-outs + Unbudgeted",
      "helpText": "Each named budget plus the leftover Unbudgeted amount (total minus named); over budget in red. Click a named bar for its transactions.",
      "steps": [{ "id": "rows", "kind": "transform", "fn": "none", "inputs": ["{{dashboard.steps.carve-outs}}"] }],
      "output": "rows",
      "visualization": {
        "type": "budget-progress",
        "accountFormat": "accountName2",
        "emptyText": "No spending under this total account for the selected month. Set a budget on the total account (Budgets view) and pick a populated month/currency.",
        "link": {
          "name": "transactions",
          "query": { "accountContains": "{{row.account}}", "dateFrom": "{{parameters.monthStart}}", "dateTo": "{{parameters.monthEnd}}" }
        }
      }
    }
  ]
}
