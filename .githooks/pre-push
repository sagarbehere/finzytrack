#!/usr/bin/env bash
# T0 pre-push (design/process/PROCESS.md, "Gates"): repo checks, types and changed-area tests, <= 2 min.
# Install once per clone:  git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
remote_name="${1:-}"
remote_url="${2:-}"

# Temporary first-push gate (IMPROVEMENTS IMP-0003): nothing reaches a remote until the owner has reviewed
# the setup of next and switched pushing on in THIS clone:  git config finzytrack.allowPush true
# Agents never set it. After that, agents commit and push per ADR-0045.
if [[ "$(git config --bool finzytrack.allowPush || echo false)" != "true" ]]; then
  echo "pre-push: refused. Pushing is off in this clone until the owner reviews and runs" >&2
  echo "          git config finzytrack.allowPush true      (remote: ${remote_name} ${remote_url})" >&2
  exit 1
fi

fail=0
run() { local label="$1"; shift; if ! "$@"; then echo "pre-push: FAILED: $label" >&2; fail=1; fi; }

run "check-script meta-tests" python3 -m unittest discover -s scripts/tests -q
run "privacy scan (all tracked files)" python3 scripts/privacy_scan.py --all --quiet
run "invariants" python3 scripts/check_invariants.py
run "capability map" python3 scripts/check_capabilities.py
run "generated artifacts" python3 scripts/check_generated.py --all
# The D1 write corpus (S0020): its stdlib check, then every case in Beancount 3.2.0 (the oracle environment).
uv_bin="$(command -v uv || echo "$HOME/.local/bin/uv")"
run "write corpus" python3 scripts/check_write_corpus.py
run "write corpus in Beancount" "$uv_bin" run --project scripts/oracle --locked python -m unittest discover \
  -s scripts/oracle/tests -p test_write_corpus.py -q
# The INV-21 goldens (S0022): the spec's derivation agrees with the v0.2.2 values, labels and key inventory hold.
run "INV-21 goldens" "$uv_bin" run --project scripts/oracle --locked python -m unittest discover \
  -s scripts/oracle/tests -p test_inv21_goldens.py -q
# The Beancount domain vectors (S0024): the committed vectors equal a fresh run of Beancount 3.2.0; checks hold.
run "Beancount domain vectors" "$uv_bin" run --project scripts/oracle --locked python -m unittest discover \
  -s scripts/oracle/tests -p test_domain_vectors.py -q
# The demo generator (S0027): every size (demo, 5k, 54k) loads in Beancount 3.2.0 with 0 errors, one assertion
# per fragment holds, only contract metadata. About 5 s.
run "demo generator in Beancount" "$uv_bin" run --project scripts/oracle --locked python -m unittest discover \
  -s scripts/oracle/tests -p test_demo_generator.py -q
# ADR-0060: CI no longer runs per push, so new Cargo.lock entries' publish dates are verified here (network only
# when the lock gained entries since the remote branch).
upstream="$(git rev-parse --verify --quiet '@{u}' || echo none)"
run "cargo 14-day rule (new entries verified)" python3 scripts/check_cargo_age.py --verify-since "$upstream"

if [[ -f backend/pyproject.toml ]]; then
  run "pyright" bash -c "cd backend && .venv/bin/pyright"
  run "import contracts" bash -c "cd backend && .venv/bin/lint-imports"
  run "declared dependencies" bash -c "cd backend && .venv/bin/deptry src"
  run "backend tests" bash -c "cd backend && .venv/bin/pytest -q -x"
fi
if [[ -f shell/src-tauri/Cargo.toml ]]; then
  cargo_bin="$(command -v cargo || echo "$HOME/.cargo/bin/cargo")"
  run "rustfmt" bash -c "cd shell/src-tauri && $cargo_bin fmt --check"
  run "clippy" bash -c "cd shell/src-tauri && $cargo_bin clippy --all-targets --locked --quiet -- -D warnings"
  run "shell unit tests" bash -c "cd shell/src-tauri && $cargo_bin test --locked --quiet"
fi
if [[ -f frontend/package.json ]]; then
  run "vue-tsc" bash -c "cd frontend && node_modules/.bin/vue-tsc --noEmit"
  run "frontend unit tests" bash -c "cd frontend && node_modules/.bin/vitest run"
  run "unused code and dependencies (knip)" bash -c "cd frontend && node_modules/.bin/knip"
fi
exit "$fail"
