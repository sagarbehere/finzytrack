        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "event": {
          "const": "gate",
          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "event"
      ],
      "title": "GateEvent",
      "type": "object"
    },
    "HandshakeReply": {
