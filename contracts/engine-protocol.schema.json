          "params": {},
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "const": "handshake",
          "title": "Op",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        }
      },
      "required": [
