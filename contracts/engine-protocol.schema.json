          "enum": [
            "keep",
            "delete_kept",
            "delete_created"
          ],
          "title": "Action",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^/",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "kept": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kept"
