    "RecoverActParams": {
      "additionalProperties": false,
      "description": "A blocked-screen action on one `.open` journal (§8.1 \"Afterwards\", §11): `keep`; `delete_kept` (`file`, the\nkept copy's entry name `kept`, and the `sha256` the user was shown); `delete_created` (`file`, `sha256`).",
