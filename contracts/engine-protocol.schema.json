{
  "$comment": "GENERATED by engine/src/ledger_engine/protocol/schema.py from the engine's message models (ADR-0054). Do not edit: run `engine/.venv/bin/python -I -m ledger_engine.protocol.schema > contracts/engine-protocol.schema.json`.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finzytrack engine protocol",
  "description": "The plain-data protocol between the main sidecar and the ledger engine. JSON Lines: one request per line on the engine's stdin, one reply per line on its protocol channel (its original stdout; stray output inside the engine goes to stderr). UTF-8, at most x-max-line-bytes per line without the newline. Every message carries `v` (x-protocol-version), `id` and `op`; a reply adds `ok` and `result` or `error`, and may carry the engine's `decision`. `handshake` comes first. One request is answered before the next is read. Before its reply a request may send job messages with its `id` and `op`: progress (any number), `gate` (at most once; the engine then reads nothing but the sidecar's `proceed` for this request) and `committed` (only after `proceed`).",
  "x-protocol-version": 2,
  "x-max-line-bytes": 16777216,
  "x-ops": [
    "handshake",
    "ping"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/Request"
    },
    {
      "$ref": "#/$defs/Reply"
    },
    {
      "$ref": "#/$defs/JobEvent"
    },
    {
      "$ref": "#/$defs/Control"
    }
  ],
  "$defs": {
    "CommittedEvent": {
      "additionalProperties": false,
      "description": "The save landed: its closed record is durable (engine-jobs §6.1 step 9).",
      "examples": [
        {
          "event": "committed",
          "id": 1,
          "op": "save",
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "event": {
          "const": "committed",
          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "event"
      ],
      "title": "CommittedEvent",
      "type": "object"
    },
    "Control": {
      "description": "A line the sidecar sends that is not a request (it gets no reply).",
      "oneOf": [
        {
          "$ref": "#/$defs/ProceedControl"
        }
      ]
    },
    "Decision": {
      "additionalProperties": false,
      "description": "An engine decision, for the decision log (engine-jobs §12): the table and its version, its inputs and its\noutput. Content-free: the inputs are flat scalars (counts, which check failed, hash equalities), never a path, a\nfile name, an amount or a hash value; the engine is responsible for that, the shape keeps nesting out.",
      "examples": [
        {
          "inputs": {
            "files": 3,
            "fingerprint_equal": true
          },
          "output": "pass",
          "table": "gate",
          "version": 1
        }
      ],
      "properties": {
        "table": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "inputs": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Inputs",
          "type": "object"
        },
        "output": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "table",
        "version",
        "inputs",
        "output"
      ],
      "title": "Decision",
      "type": "object"
    },
    "GateEvent": {
      "additionalProperties": false,
      "description": "The job reached its commit point and waits for `proceed` (engine-jobs §4, §6.1 step 7).",
      "examples": [
        {
          "event": "gate",
          "id": 1,
          "op": "save",
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "event": {
          "const": "gate",
          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "event"
      ],
      "title": "GateEvent",
      "type": "object"
    },
    "HandshakeReply": {
      "additionalProperties": false,
      "description": "The accepted reply to `handshake`.",
      "examples": [
        {
          "id": 1,
          "ok": true,
          "op": "handshake",
          "result": {
            "beancount_version": "3.2.0",
            "engine_version": "0.4.0",
            "protocol": 2
          },
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "const": "handshake",
          "title": "Op",
          "type": "string"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/HandshakeResult"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "ok",
        "result"
      ],
      "title": "HandshakeReply",
      "type": "object"
    },
    "HandshakeRequest": {
      "additionalProperties": false,
      "description": "The `handshake` request.",
      "examples": [
        {
          "id": 1,
          "op": "handshake",
          "params": {},
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "const": "handshake",
          "title": "Op",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "params"
      ],
      "title": "HandshakeRequest",
      "type": "object"
    },
    "HandshakeResult": {
      "additionalProperties": false,
      "description": "What the engine is: the protocol it speaks and the versions that shape its answers.",
      "properties": {
        "protocol": {
          "minimum": 1,
          "title": "Protocol",
          "type": "integer"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "beancount_version": {
          "title": "Beancount Version",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "engine_version",
        "beancount_version"
      ],
      "title": "HandshakeResult",
      "type": "object"
    },
    "JobEvent": {
      "description": "A job message the engine sends before its reply.",
      "oneOf": [
        {
          "$ref": "#/$defs/ProgressEvent"
        },
        {
          "$ref": "#/$defs/GateEvent"
        },
        {
          "$ref": "#/$defs/CommittedEvent"
        }
      ]
    },
    "NoParams": {
      "additionalProperties": false,
      "description": "An op that takes no parameters.",
      "properties": {},
      "title": "NoParams",
      "type": "object"
    },
    "Phase": {
      "enum": [
        "reading",
        "checking_change",
        "waiting_for_files",
        "saving",
        "updating_views",
        "checking_last_change"
      ],
      "type": "string"
    },
    "PingReply": {
      "additionalProperties": false,
      "description": "The accepted reply to `ping`.",
      "examples": [
        {
          "id": 1,
          "ok": true,
          "op": "ping",
          "result": {
            "status": "ok"
          },
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "const": "ping",
          "title": "Op",
          "type": "string"
        },
        "ok": {
          "const": true,
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/PingResult"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "ok",
        "result"
      ],
      "title": "PingReply",
      "type": "object"
    },
    "PingRequest": {
      "additionalProperties": false,
      "description": "The `ping` request.",
      "examples": [
        {
          "id": 1,
          "op": "ping",
          "params": {},
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "const": "ping",
          "title": "Op",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "params"
      ],
      "title": "PingRequest",
      "type": "object"
    },
    "PingResult": {
      "additionalProperties": false,
      "description": "The engine is up and reading requests.",
      "properties": {
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "PingResult",
      "type": "object"
    },
    "ProceedControl": {
      "additionalProperties": false,
      "description": "The sidecar's answer to a gate: go past the commit point (engine-jobs §4).",
      "examples": [
        {
          "control": "proceed",
          "id": 1,
          "op": "save",
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "control": {
          "const": "proceed",
          "title": "Control",
          "type": "string"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "control"
      ],
      "title": "ProceedControl",
      "type": "object"
    },
    "ProgressEvent": {
      "additionalProperties": false,
      "description": "The job's phase changed (engine-jobs §5.4: shown, never judged).",
      "examples": [
        {
          "event": "progress",
          "id": 1,
          "op": "save",
          "phase": "reading",
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Id",
          "type": "integer"
        },
        "op": {
          "title": "Op",
          "type": "string"
        },
        "event": {
          "const": "progress",
          "title": "Event",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "event",
        "phase"
      ],
      "title": "ProgressEvent",
      "type": "object"
    },
    "Refusal": {
      "additionalProperties": false,
      "description": "A refused request, or a line that was not a request. `id` and `op` are those of the request when it could\nbe read that far, else null; `op` is null too when it cannot be echoed exactly (not valid Unicode, or longer\nthan 128 characters).",
      "examples": [
        {
          "error": {
            "key": "protocol.handshake_required",
            "message": "Send handshake first."
          },
          "id": 1,
          "ok": false,
          "op": "ping",
          "v": 2
        },
        {
          "error": {
            "key": "protocol.malformed",
            "message": "The line is not JSON."
          },
          "id": null,
          "ok": false,
          "op": null,
          "v": 2
        }
      ],
      "properties": {
        "v": {
          "const": 2,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Id"
        },
        "op": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Op"
        },
        "ok": {
          "const": false,
          "title": "Ok",
          "type": "boolean"
        },
        "error": {
          "$ref": "#/$defs/RefusalBody"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "v",
        "id",
        "op",
        "ok",
        "error"
      ],
      "title": "Refusal",
      "type": "object"
    },
    "RefusalBody": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/$defs/RefusalKey"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "key",
        "message"
      ],
      "title": "RefusalBody",
      "type": "object"
    },
    "RefusalKey": {
      "enum": [
        "protocol.malformed",
        "protocol.version_mismatch",
        "protocol.unknown_op",
        "protocol.invalid_params",
        "protocol.handshake_required",
        "engine.internal"
      ],
      "type": "string"
    },
    "Reply": {
      "description": "Any reply the engine sends.",
      "oneOf": [
        {
          "$ref": "#/$defs/HandshakeReply"
        },
        {
          "$ref": "#/$defs/PingReply"
        },
        {
          "$ref": "#/$defs/Refusal"
        }
      ]
    },
    "Request": {
      "description": "Any request the engine accepts.",
      "oneOf": [
        {
          "$ref": "#/$defs/HandshakeRequest"
        },
        {
          "$ref": "#/$defs/PingRequest"
        }
      ]
    }
  }
}
