        "engine_version",
        "beancount_version"
      ],
      "title": "HandshakeResult",
      "type": "object"
    },
    "InspectedFile": {
      "additionalProperties": false,
      "description": "What stands at one file of a stopped journal now, and its kept copies (§11: Show both, Show it).",
