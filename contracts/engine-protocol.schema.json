    "ListedJournal": {
      "additionalProperties": false,
      "description": "An `.open` record found by the listing. `readable` False: it names nothing it can be matched on (torn,\nforeign, newer, of another name, or a read error: `errno`), so it blocks every open (ADR-0063).",
      "properties": {
        "journal_dir": {
          "minLength": 1,
          "pattern": "^/",
          "title": "Journal Dir",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "readable": {
          "title": "Readable",
          "type": "boolean"
        },
        "workspace_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Workspace Key"
        },
        "lineage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lineage"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/JournalFile"
          },
          "title": "Files",
          "type": "array"
        },
        "errno": {
          "anyOf": [
