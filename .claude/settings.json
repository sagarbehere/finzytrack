{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git clean -x:*)",
      "Bash(git clean -X:*)",
      "Bash(git clean -fx:*)",
      "Bash(git clean -fX:*)",
      "Bash(git clean -dx:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git clean -fdX:*)",
      "Bash(git clean -xfd:*)",
      "Read(~/FinzytrackData/**)",
      "Edit(~/FinzytrackData/**)",
      "Edit(~/experiments/finzytrack-legacy/**)",
      "Edit(.claude/settings.json)"
    ],
    "allow": [
      "Bash(git push:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "git push origin next",
      "gh workflow run *",
      "gh run list *",
      "gh run view *",
      "gh run watch *",
      "gh api *",
      "pnpm --dir frontend -s e2e",
      "pnpm --dir frontend install --frozen-lockfile"
    ],
    "filesystem": {
      "denyWrite": [
        "~/FinzytrackData",
        "~/experiments/finzytrack-legacy"
      ],
      "allowWrite": [
        "~/.cache/uv",
        "~/Library/pnpm",
        "~/experiments/finzytrack-docs",
        "~/ft-local-tier"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_bash.py\""
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_paths.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Task|SendMessage|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_agent.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/fmt_lint_file.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_checks.py\"",
            "timeout": 1800
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_compact.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\""
          }
        ]
      }
    ]
  }
}
